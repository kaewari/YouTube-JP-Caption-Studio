    "text": "いらっしゃいませ。"
  },
  {
    "id": "239519-63",
    "start": 239519,
    "duration": 4800,
    "text": "アイスカフェオレを1つ。"
  },
  {
    "id": "241319-64",
    "start": 241319,
    "duration": 3000,
    "text": "君たちは欲しいものはあるかな?車内飲食"
