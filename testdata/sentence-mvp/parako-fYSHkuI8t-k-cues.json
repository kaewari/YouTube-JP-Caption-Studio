[
  {
    "id": "800-0",
    "start": 800,
    "duration": 9320,
    "text": "おはようはえ教室間違えてない"
  },
  {
    "id": "6600-1",
    "start": 6600,
    "duration": 7959,
    "text": "え何これ昨日までこんなのじゃなかったの"
  },
  {
    "id": "10120-2",
    "start": 10120,
    "duration": 8720,
    "text": "におはようヒカルえディスマンなんだよ"
  },
  {
    "id": "14559-3",
    "start": 14559,
    "duration": 8001,
    "text": "そこ黒いの席俺の席あはいよしみんないる"
  },
  {
    "id": "18840-4",
    "start": 18840,
    "duration": 7439,
    "text": "なえ違和感ないの先生今学期の学級委員を"
  },
  {
    "id": "22560-5",
    "start": 22560,
    "duration": 6520,
    "text": "決めるぞなんで全員やる気あるんだよ自分"
  },
  {
    "id": "26279-6",
    "start": 26279,
    "duration": 5480,
    "text": "は忘れたくても忘れられないほど影響力が"
  },
  {
    "id": "29080-7",
    "start": 29080,
    "duration": 5560,
    "text": "強いと言われます夢に出るくらいだしな僕"
  },
  {
    "id": "31759-8",
    "start": 31759,
    "duration": 7001,
    "text": "は危機管理能力が高いですなんか乗っ取ら"
  },
  {
    "id": "34640-9",
    "start": 34640,
    "duration": 6919,
    "text": "れてたじゃんお帰り3回見たら死ぬえ私は"
  },
  {
    "id": "38760-10",
    "start": 38760,
    "duration": 6400,
    "text": "1度会っただけでその人と友達になれます"
  },
  {
    "id": "41559-11",
    "start": 41559,
    "duration": 6640,
    "text": "3回目で死ぬから余裕ないんだな私が学級"
  },
  {
    "id": "45160-12",
    "start": 45160,
    "duration": 7559,
    "text": "員になったらいや後ろの髪が気になって話"
  },
  {
    "id": "48199-13",
    "start": 48199,
    "duration": 7840,
    "text": "が入ってこないよみんなで踊るだけって何"
  },
  {
    "id": "52719-14",
    "start": 52719,
    "duration": 6520,
    "text": "なんか言わないと私は人見知りをしません"
  },
  {
    "id": "56039-15",
    "start": 56039,
    "duration": 8001,
    "text": "するだろそれで人殺してただろ私は人殺し"
  },
  {
    "id": "59239-16",
    "start": 59239,
    "duration": 9681,
    "text": "しませんしてるだろ毎週次ただえ俺も"
  },
  {
    "id": "64040-17",
    "start": 64040,
    "duration": 7399,
    "text": "あえっとよ光る"
  },
  {
    "id": "68920-18",
    "start": 68920,
    "duration": 6000,
    "text": "あ僕が"
  },
  {
    "id": "71439-19",
    "start": 71439,
    "duration": 7081,
    "text": "ああヒカル笑顔笑顔"
  },
  {
    "id": "74920-20",
    "start": 74920,
    "duration": 7760,
    "text": "ありがとう僕が学級員になった暁月には"
  },
  {
    "id": "78520-21",
    "start": 78520,
    "duration": 9120,
    "text": "明るいクラスにしたいですじゃあ投票だ"
  },
  {
    "id": "82680-22",
    "start": 82680,
    "duration": 8040,
    "text": "学級員はヒカルに決定嘘だろ頼むぜヒカル"
  },
  {
    "id": "87640-23",
    "start": 87640,
    "duration": 6920,
    "text": "俺じゃまとめられないよこのクラス"
  },
  {
    "id": "90720-24",
    "start": 90720,
    "duration": 7120,
    "text": "ファイトピカルンえ平らいたの学級委員"
  },
  {
    "id": "94560-25",
    "start": 94560,
    "duration": 6960,
    "text": "ひどすぎ受けるもしかしてこいつらって"
  },
  {
    "id": "97840-26",
    "start": 97840,
    "duration": 5520,
    "text": "パラレルから連れてきたずっとも飽きたら"
  },
  {
    "id": "101520-27",
    "start": 101520,
    "duration": 5840,
    "text": "元のクラスに戻して"
  },
  {
    "id": "103360-28",
    "start": 103360,
    "duration": 6280,
    "text": "ねチャンネル登録よろあちなこの曲"
  },
  {
    "id": "107360-29",
    "start": 107360,
    "duration": 4600,
    "text": "AppleミッとかSpotifyとかで"
  },
  {
    "id": "109640-30",
    "start": 109640,
    "duration": 6880,
    "text": "聞けますSpotifyってスポーツ"
  },
  {
    "id": "111960-31",
    "start": 111960,
    "duration": 10920,
    "text": "みたいじゃねあねそっちもやら止らないめ"
  },
  {
    "id": "116520-32",
    "start": 116520,
    "duration": 12760,
    "text": "られないちらに最高で未来はヘこういう屈"
  },
  {
    "id": "122880-33",
    "start": 122880,
    "duration": 6400,
    "text": "説あるまだりたくないね"
  }
]